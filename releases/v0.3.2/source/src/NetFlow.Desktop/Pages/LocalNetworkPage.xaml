<UserControl x:Class="NetFlow.Desktop.Pages.LocalNetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="网络适配器">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ProxyText" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondary}"/>
                    <DataGrid x:Name="AdapterGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" MinWidth="110"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="IPv4" Binding="{Binding Ipv4}" Width="1*" MinWidth="115"/>
                            <DataGridTextColumn Header="前缀" Binding="{Binding Prefixes}" Width="1.2*" MinWidth="135"/>
                            <DataGridTextColumn Header="网关" Binding="{Binding Gateways}" Width="1*" MinWidth="115"/>
                            <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="1.8*" MinWidth="150"/>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="1.3*" MinWidth="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
        <TabItem Header="路由表">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="目标地址（IP）" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="RouteTargetInput" IsEditable="True" Width="240"
                                      Tag="如 192.168.1.10"/>
                        </StackPanel>
                        <Button Content="查询路由" Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="Route_Click"/>
                    </StackPanel>
                    <TextBox x:Name="RouteResult" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Tag="输入目标 IP，查看源地址、下一跳与出口接口"/>
                </DockPanel>
            </Border>
        </TabItem>
        <TabItem Header="监听端口">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                <DataGrid x:Name="ListenerGrid" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                        <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="140"/>
                        <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="90"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                        <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="140"/>
                        <DataGridTextColumn Header="进程路径" Binding="{Binding ProcessPath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </TabItem>
        <TabItem Header="防火墙规则">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="规则仅为配置信息，不能证明流量实际被放行。"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="加载规则" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Firewall_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="FirewallGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="220"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="70"/>
                            <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="70"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPorts}" Width="120"/>
                            <DataGridTextColumn Header="程序" Binding="{Binding Program}" Width="*"/>
                            <DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="56"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
