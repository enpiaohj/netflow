<UserControl x:Class="NetFlow.Desktop.Pages.ScenarioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标主机" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TargetInput" Style="{StaticResource InputStyle}"
                             Margin="0,0,10,0" KeyDown="TargetInput_KeyDown"/>
                    <TextBlock Grid.Column="2" Text="域" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="3" x:Name="DomainInput" Style="{StaticResource InputStyle}"
                             Margin="0,0,14,0"/>
                    <CheckBox Grid.Column="4" x:Name="CaptureToggle" Content="同时抓包"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Grid.Column="5" x:Name="RunButton" Content="开始诊断"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="Run_Click"/>
                    <Button Grid.Column="6" x:Name="StopButton" Content="停止"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Click="Stop_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="目标主机（IP 或域名）｜域（用于 SRV/SPN 类查询占位 {domain}）"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="ProgressText" Text="" Margin="14,0,0,0"
                               FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 模板列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" x:Name="SaveTemplateButton"
                            Content="保存为新模板" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,8,0,0" Click="SaveTemplate_Click"/>
                    <TextBlock DockPanel.Dock="Top" Text="场景模板" Style="{StaticResource SectionTitleStyle}"/>
                    <ListBox x:Name="TemplateList" BorderThickness="0" Background="Transparent"
                             Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <!-- 检查结果 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ResultTitle" Text="诊断概览"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <!-- KPI 统计卡（对齐概念图 01 诊断概览） -->
                    <WrapPanel DockPanel.Dock="Top" x:Name="StatCards" Visibility="Collapsed"
                               Margin="0,8,0,10">
                        <Border Style="{StaticResource KpiCardStyle}" Background="#F0FDF4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✔" FontSize="22" Foreground="#16A34A" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock x:Name="KpiPass" Text="0" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="通过" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCardStyle}" Background="#FFFBEB" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="22" Foreground="#D97706" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock x:Name="KpiWarn" Text="0" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="警告" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCardStyle}" Background="#EFF6FF" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕐" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock x:Name="KpiUnconfirmed" Text="0" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="未确认" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCardStyle}" Background="#FEF2F2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✖" FontSize="20" Foreground="#DC2626" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock x:Name="KpiFail" Text="0" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="失败" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <!-- 事件时间线（对齐概念图 01 底部时间线：彩点 + 事件） -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="抓包与测试事件时间线" Style="{StaticResource SectionTitleStyle}"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="EventTimeline">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding DotBrush}"/>
                                                <TextBlock Text="{Binding Time}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Text}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ResultGrid" Style="{StaticResource DataGridStyle}" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding No}" Width="34"/>
                            <DataGridTextColumn Header="检查项" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="结论" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding LevelBrush}" CornerRadius="10"
                                                Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Level}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="100"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="100"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="76"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 证据面板 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="诊断证据" Style="{StaticResource SectionTitleStyle}"/>
                    <Button DockPanel.Dock="Bottom" x:Name="ExportButton" Content="导出报告"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                            IsEnabled="False" Click="Export_Click"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="EvidenceBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" MinHeight="300"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
