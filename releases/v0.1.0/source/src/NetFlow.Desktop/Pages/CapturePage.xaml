<UserControl x:Class="NetFlow.Desktop.Pages.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="过滤目标" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TargetInput" Style="{StaticResource InputStyle}"
                             Margin="0,0,12,0" Text="192.168.10.11"/>
                    <TextBlock Grid.Column="2" Text="最长时长(秒)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3" x:Name="DurationInput" Text="120" Style="{StaticResource InputStyle}"
                             Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4" Text="截断(字节)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="5" x:Name="SnapInput" Text="128" Style="{StaticResource InputStyle}"
                             Margin="0,0,12,0"/>
                    <Button Grid.Column="6" x:Name="StartButton" Content="开始抓包"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                            Click="Start_Click"/>
                    <Button Grid.Column="7" x:Name="StopButton" Content="停止"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            IsEnabled="False" Click="Stop_Click"/>
                    <Button Grid.Column="8" Content="导入 PCAPNG"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            Click="Import_Click"/>
                    <Button Grid.Column="9" x:Name="TsharkButton" Content="TShark 深度解析"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Tshark_Click" ToolTip="需要已安装 Wireshark/TShark（可选组件）"/>
                </Grid>
                <TextBlock x:Name="CaptureHint" Text="抓包经独立提权宿主执行（Pktmon，过滤单个 IP）；到达最长时长自动结束。停止后需等待宿主写出转换结果。"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="PacketTitle" Text="数据包列表"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <DataGrid x:Name="PacketGrid" Style="{StaticResource DataGridStyle}" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding No}" Width="52"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="120"/>
                            <DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="120"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="信息" Binding="{Binding Info}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="异常分析" Style="{StaticResource SectionTitleStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="AnalysisBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" MinHeight="300"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
