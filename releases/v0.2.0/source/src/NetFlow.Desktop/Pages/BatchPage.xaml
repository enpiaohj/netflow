<UserControl x:Class="NetFlow.Desktop.Pages.BatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="并发数" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ConcurrencyInput" Text="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="超时（秒）" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TimeoutInput" Text="3"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="RunButton" Content="运行任务" VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click"/>
                </Grid>
                <TextBlock Text="目标列表（每行一个 host:port）" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="TargetsInput" AcceptsReturn="True" Height="84"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="12"
                         Tag="例如：&#x0a;192.168.1.10:443&#x0a;example.com:53"/>
                <TextBlock Text="局部失败不终止整批；完成后可只重跑失败项。"
                           Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Text="目标检测矩阵"
                           Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="0,6,0,0">
                <DataGrid x:Name="BatchGrid" Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="220"/>
                        <DataGridTemplateColumn Header="结论" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding LevelBrush}" CornerRadius="10"
                                            Padding="9,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Level}" FontSize="11" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="120"/>
                        <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="90"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="填写目标列表后点击“运行任务”，逐目标的检测结果显示在这里">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=BatchGrid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 持续监测（设计文档 4.8：低频定时探针，采样缺口不计入目标故障） -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="持续监测" Style="{StaticResource SectionTitleStyle}"/>
                <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="目标（host:port）" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MonitorTargetInput" Tag="如 192.168.1.10:443"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="间隔（秒）" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MonitorIntervalInput" Text="60"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="MonitorStartButton" Content="启动监测"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                                Click="MonitorStart_Click"/>
                        <Button x:Name="MonitorStopButton" Content="停止"
                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                Click="MonitorStop_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="MonitorSummary" VerticalAlignment="Bottom"
                               Foreground="{StaticResource TextSecondary}" Margin="14,0,0,8"
                               TextWrapping="Wrap"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SampleStrip" Height="42">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="6" Height="30" Margin="1,0"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{Binding Color}"
                                           ToolTip="{Binding Note}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
