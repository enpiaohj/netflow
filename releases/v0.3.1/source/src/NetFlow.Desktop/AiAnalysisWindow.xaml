<Window x:Class="NetFlow.Desktop.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 深入分析" Width="940" Height="780" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Icon="Assets/NetFlow.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="ProviderText" Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 将发送的内容：发送前可预览（已脱敏） -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12,8">
            <Expander x:Name="ContextExpander">
                <Expander.Header>
                    <TextBlock x:Name="ContextHeader" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="ContextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" MaxHeight="220" Margin="0,8,0,0"
                         FontFamily="Consolas" FontSize="12" Background="#F8FAFC"/>
            </Expander>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="补充问题（可选）" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="QuestionBox" Tag="例如：445 端口不通，应先排查哪一端？"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartButton" Content="确认发送并分析" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0" Click="Start_Click"/>
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" IsEnabled="False" Click="Cancel_Click"/>
            <Button x:Name="CopyButton" Content="复制结果" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,16,0" IsEnabled="False" Click="Copy_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" FontSize="13"
                     Tag="分析结果显示在此处。AI 结论仅供参考，请结合证据核实。"/>
        </Border>
    </Grid>
</Window>
