<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetFlow.Application\NetFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\NetFlow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口/任务栏图标（与 exe 图标同一份 ico；母版由 scripts/generate_icon.py 生成） -->
    <Resource Include="Assets\NetFlow.ico" />
  </ItemGroup>

</Project>
