<UserControl x:Class="NetFlow.Desktop.Pages.BatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="并发数" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="ConcurrencyInput" Text="8"
                             Style="{StaticResource InputStyle}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="超时(秒)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3" x:Name="TimeoutInput" Text="3"
                             Style="{StaticResource InputStyle}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="目标列表（每行 host:port）" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Grid.Column="6" x:Name="RunButton" Content="运行任务"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click"/>
                </Grid>
                <TextBox x:Name="TargetsInput" Style="{StaticResource InputStyle}" Margin="0,8,0,0"
                         AcceptsReturn="True" Height="70" FontFamily="Consolas" FontSize="12"
                         Text="192.168.10.11:53&#x0a;192.168.10.11:88&#x0a;192.168.10.11:389&#x0a;192.168.10.11:445&#x0a;192.168.10.15:445&#x0a;192.168.10.15:1433"/>
                <TextBlock Text="局部失败不终止整批；完成后可只重跑失败项。"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Text="目标检测矩阵"
                           Style="{StaticResource SectionTitleStyle}"/>
                <DataGrid x:Name="BatchGrid" Style="{StaticResource DataGridStyle}" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="220"/>
                        <DataGridTextColumn Header="结论" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="120"/>
                        <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="90"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 持续监测（设计文档 4.8：低频定时探针，采样缺口不计入目标故障） -->
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Height="6" Background="{StaticResource BorderLight}"/>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,6,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="持续监测" Style="{StaticResource SectionTitleStyle}"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="目标 host:port" VerticalAlignment="Center"/>
                    <TextBox x:Name="MonitorTargetInput" Text="192.168.10.11:445" Width="170"
                             Style="{StaticResource InputStyle}" Margin="6,0,10,0"/>
                    <TextBlock Text="间隔(秒)" VerticalAlignment="Center"/>
                    <TextBox x:Name="MonitorIntervalInput" Text="60" Width="60"
                             Style="{StaticResource InputStyle}" Margin="6,0,10,0"/>
                    <Button x:Name="MonitorStartButton" Content="启动监测"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                            Click="MonitorStart_Click"/>
                    <Button x:Name="MonitorStopButton" Content="停止"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Click="MonitorStop_Click"/>
                    <TextBlock x:Name="MonitorSummary" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SampleStrip" Height="42">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="6" Height="30" Margin="1,0"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{Binding Color}"
                                           ToolTip="{Binding Note}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
