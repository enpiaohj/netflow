<UserControl x:Class="NetFlow.Desktop.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchInput" Style="{StaticResource InputStyle}" Width="320"
                         Margin="0,0,10,0"/>
                <Button Content="刷新" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0" Click="Refresh_Click"/>
                <Button Content="打开报告" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0" Click="OpenReport_Click"/>
                <Button Content="打开证据目录" Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenFolder_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="HistoryGrid" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding StartLocal}" Width="160"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*"/>
                    <DataGridTextColumn Header="场景" Binding="{Binding ScenarioName}" Width="200"/>
                    <DataGridTextColumn Header="任务 ID" Binding="{Binding Id}" Width="280"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
