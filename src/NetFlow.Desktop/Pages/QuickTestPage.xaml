<UserControl x:Class="NetFlow.Desktop.Pages.QuickTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 目标与选项 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标地址" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TargetInput" Style="{StaticResource InputStyle}"
                             Margin="0,0,10,0" KeyDown="TargetInput_KeyDown"/>
                    <ComboBox Grid.Column="2" x:Name="PortInput" IsEditable="True" Margin="0,0,10,0">
                        <ComboBoxItem IsSelected="True">445</ComboBoxItem>
                        <ComboBoxItem>53</ComboBoxItem>
                        <ComboBoxItem>88</ComboBoxItem>
                        <ComboBoxItem>389</ComboBoxItem>
                        <ComboBoxItem>443</ComboBoxItem>
                        <ComboBoxItem>1433</ComboBoxItem>
                    </ComboBox>
                    <TextBox Grid.Column="3" x:Name="TimeoutInput" Text="3" Margin="0,0,10,0"/>
                    <Button Grid.Column="4" x:Name="StartButton" Content="开始测试"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"
                            Click="Start_Click"/>
                    <Button Grid.Column="5" x:Name="StopButton" Content="停止"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False" Click="Stop_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="目标地址｜端口｜超时（秒）。无响应显示“—”，不显示伪造 0ms。"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="InlineError" Text="" Margin="14,0,0,0"
                               FontSize="12" Foreground="{StaticResource StatusFail}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 测试类型 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabTcpUdp" Content="TCP/UDP 端口" IsChecked="True"
                             Margin="0,0,16,0" Tag="tcpudp"/>
                <RadioButton x:Name="TabDns" Content="DNS 解析" Margin="0,0,16,0" Tag="dns"/>
                <RadioButton x:Name="TabHttp" Content="HTTP/TLS" Margin="0,0,16,0" Tag="http"/>
                <RadioButton x:Name="TabPing" Content="Ping/路径" Margin="0,0,16,0" Tag="ping"/>
                <RadioButton x:Name="TabNtp" Content="NTP" Margin="0,0,16,0" Tag="ntp"/>
            </StackPanel>
        </Border>

        <!-- 结果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ResultTitle" Text="测试结果"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <DataGrid x:Name="ResultGrid" Style="{StaticResource DataGridStyle}" Margin="0,6,0,0"
                              SelectionChanged="ResultRow_Selected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="探针" Binding="{Binding Probe}" Width="110"/>
                            <DataGridTemplateColumn Header="结论" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding LevelBrush}" CornerRadius="10"
                                                Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Level}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="110"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="110"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="EvidenceTitle" Text="观察事实与证据"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                                 MinHeight="300"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
