<UserControl x:Class="NetFlow.Desktop.Pages.ScenarioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="目标主机" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TargetInput" Style="{StaticResource InputStyle}"
                         Margin="0,0,10,0" Text="dc01.corp.example.com"/>
                <TextBlock Grid.Column="2" Text="域" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="DomainInput" Style="{StaticResource InputStyle}"
                         Margin="0,0,10,0" Text="corp.example.com"/>
                <CheckBox Grid.Column="4" x:Name="CaptureToggle" Content="同时抓包"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Grid.Column="5" x:Name="RunButton" Content="开始诊断"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 模板列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="场景模板" Style="{StaticResource SectionTitleStyle}"/>
                    <ListBox x:Name="TemplateList" BorderThickness="0" Background="Transparent"
                             Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <!-- 检查结果 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ResultTitle" Text="诊断概览"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <DataGrid x:Name="ResultGrid" Style="{StaticResource DataGridStyle}" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding No}" Width="34"/>
                            <DataGridTextColumn Header="检查项" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="结论" Binding="{Binding Level}" Width="76"/>
                            <DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="100"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="100"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="76"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 证据面板 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="诊断证据" Style="{StaticResource SectionTitleStyle}"/>
                    <Button DockPanel.Dock="Bottom" x:Name="ExportButton" Content="导出报告"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                            IsEnabled="False" Click="Export_Click"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="EvidenceBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" MinHeight="300"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
