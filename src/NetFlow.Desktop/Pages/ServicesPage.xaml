<UserControl x:Class="NetFlow.Desktop.Pages.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标服务器" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TargetInput" Style="{StaticResource InputStyle}"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="刷新" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Refresh_Click"/>
                </Grid>
                <TextBlock Text="留空 = 本机。远端查询使用当前 Windows 身份的已有权限；无权限时显示未检查及原因，不推测服务状态。"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent">
            <TabItem Header="服务状态">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DataGrid x:Name="ServiceGrid" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="服务名" Binding="{Binding ServiceName}" Width="160"/>
                            <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="事件日志">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="日志：" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogNameInput" Text="System" Width="140"
                                     Style="{StaticResource InputStyle}" Margin="4,0,10,0"/>
                            <TextBlock Text="条数：" VerticalAlignment="Center"/>
                            <TextBox x:Name="EventCountInput" Text="20" Width="60"
                                     Style="{StaticResource InputStyle}" Margin="4,0,10,0"/>
                            <Button Content="查询" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Events_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="EventGrid" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeLocal}" Width="150"/>
                                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70"/>
                                <DataGridTextColumn Header="事件 ID" Binding="{Binding EventId}" Width="80"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Provider}" Width="140"/>
                                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="监听端口">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="监听状态仅表示本机应用接受连接，不代表从远程主机一定可以访问该端口。"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,6"/>
                        <DataGrid x:Name="ListenerGrid" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="130"/>
                                <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="90"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
