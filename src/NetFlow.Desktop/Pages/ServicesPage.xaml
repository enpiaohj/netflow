<UserControl x:Class="NetFlow.Desktop.Pages.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="目标计算机" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="TargetInput" IsEditable="True"
                                  Tag="留空表示本机；远程请输入主机名或 IP"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="检测远程端口" Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Bottom" Margin="0,0,10,0" Click="PortCheck_Click"
                            ToolTip="检测目标 TCP 135（RPC）与 445（SMB）的可达性"/>
                    <Button Grid.Column="2" Content="刷新服务" Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom" Click="Refresh_Click"/>
                </Grid>
                <TextBlock x:Name="RemoteHint" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"/>
                <TextBlock x:Name="PortCheckText" Style="{StaticResource StatusLineStyle}" Margin="0,4,0,0"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="ServiceHint" Style="{StaticResource StatusLineStyle}" Margin="0,4,0,0"
                           Foreground="{StaticResource StatusFail}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="服务状态">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <Grid>
                        <DataGrid x:Name="ServiceGrid" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="服务名" Binding="{Binding ServiceName}" Width="180"/>
                                <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="启动类型" Binding="{Binding StartType}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="点击“刷新服务”加载服务状态">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=ServiceGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="事件日志">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <WrapPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="日志" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="LogNameInput" IsEditable="True" Width="270"
                                              ToolTip="选择预置日志或输入日志名（如 Microsoft-Windows-DNS-Client/Operational）"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="级别" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="LevelInput" Width="200"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="时间范围" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="TimeInput" Width="140"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="事件 ID" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="EventIdInput" IsEditable="True" Width="240"
                                              Tag="不限；多个 ID 以逗号分隔"
                                              ToolTip="例如 4625 登录失败、4740 账户锁定、7036 服务状态变化"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="条数" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="EventCountInput" IsEditable="True" Width="90"/>
                                </StackPanel>
                                <Button Content="查询" Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,8" Click="Events_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="筛选条件可组合使用。读取 Security 日志需管理员权限或 Event Log Readers 组成员身份。"/>
                            <TextBlock x:Name="EventHint" Style="{StaticResource StatusLineStyle}" Margin="0,4,0,0"
                                       Foreground="{StaticResource StatusFail}"/>
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="EventGrid" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding TimeLocal}" Width="150"/>
                                    <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70"/>
                                    <DataGridTextColumn Header="事件 ID" Binding="{Binding EventId}" Width="80"/>
                                    <DataGridTextColumn Header="来源" Binding="{Binding Provider}" Width="260"/>
                                    <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="设置筛选条件后，点击“查询”">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=EventGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="监听端口">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="监听仅表示本机应用接受连接，不代表远程可访问。"
                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"/>
                        <DataGrid x:Name="ListenerGrid" Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="130"/>
                                <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="90"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
