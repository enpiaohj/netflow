<Window x:Class="NetFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetFlow｜网络与服务诊断"
        Icon="Assets/NetFlow.ico"
        Height="860" Width="1360" MinHeight="680" MinWidth="1100"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                    <TextBlock Text="NetFlow" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="网络与服务诊断" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                    <TextBlock x:Name="VersionText" Text="v0.2.0" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                    <RadioButton AutomationProperties.Name="总览" x:Name="NavOverview"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" IsChecked="True" Checked="Nav_Checked" Tag="overview">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="总览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="快速测试"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="quicktest">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="快速测试" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="场景诊断"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="scenario">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="场景诊断" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="抓包分析"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="capture">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="抓包分析" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="服务与日志"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="services">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="服务与日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="本机网络"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="localnet">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="本机网络" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="批量任务"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="batch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="批量任务" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="历史报告"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="history">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="历史报告" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="设置"  Style="{StaticResource NavButtonStyle}"
                                 GroupName="nav" Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="15" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部状态栏：任务状态（设计文档 3.1 交互规范） -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="源网卡：" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="SourceAdapterCombo" Width="360" Margin="0,0,20,0"
                                  Padding="8,3,26,3" FontSize="13"
                                  DisplayMemberPath="Display" VerticalContentAlignment="Center"
                                  SelectionChanged="SourceAdapterCombo_SelectionChanged"
                                  ToolTip="测试使用的源网卡（默认：带默认网关的以太网卡）。LDAP、SQL 登录阶段无法指定源地址，结果中将注明"/>
                        <TextBlock Text="状态：" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ActivityButton" Visibility="Collapsed"
                                Click="ActivityButton_Click" Cursor="Hand"
                                Background="#FFF7ED" BorderBrush="#FED7AA"
                                BorderThickness="1" Padding="10,3" Margin="0,0,14,0"
                                ToolTip="转到运行中的任务">
                            <TextBlock x:Name="ActivityText" Text="● 运行中"
                                       Foreground="#C2410C" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </Button>
                        <TextBlock x:Name="ElevatedText" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="PageHost" Margin="16"/>
        </Grid>
    </Grid>
</Window>
